# Names only. Real values live in Vercel (Preview scope) or a local .env.local, which is never committed.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=
# Lead forms (/api/lead). RESEND_API_KEY is what sends the email. LEAD_NOTIFY_TO, if set, receives the internal lead email instead
# of contact@ (ignored when VERCEL_ENV is production). The sheet log needs LEADS_WEBHOOK_URL and LEADS_WEBHOOK_TOKEN, which belong in
# Production only, never on the preview project.
RESEND_API_KEY=
LEAD_NOTIFY_TO=
